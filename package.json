{
  "name": "vue-vant-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/uzhan/vue-vant-template#readme",
  "bugs": {
    "url": "https://github.com/uzhan/vue-vant-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzhan/vue-vant-template.git"
  },
  "funding": "https://github.com/sponsors/uzhan",
  "author": {
    "name": "BaiHuaYang",
    "email": "baihuayang@uphicoo.com"
  },
  "engines": {
    "node": ">= 20",
    "pnpm": ">= 10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxfmt src",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,json,jsonc,json5,yaml,yml,html,css,scss,less,graphql,md,mdx}": [
      "oxfmt"
    ]
  },
  "dependencies": {
    "axios": "^1.7.7",
    "clipboard": "^2.0.11",
    "js-base64": "^3.7.7",
    "jsencrypt": "^3.3.2",
    "pinia": "^2.2.2",
    "vant": "^4.9.5",
    "vue": "^3.5.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^25.0.2",
    "@vant/auto-import-resolver": "^1.2.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.8.0",
    "oxlint": "^1.34.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.24.1",
    "vconsole": "^3.15.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.14.7",
    "vite-plugin-style-import": "^2.0.0",
    "vite-plugin-vconsole": "^1.3.1",
    "vite": "npm:rolldown-vite@7.2.5",
    "vue-tsc": "^3.1.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.2.5"
    }
  }
}
