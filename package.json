{
  "name": "vue-vant-template",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/uzhan/vue-vant-template#readme",
  "bugs": {
    "url": "https://github.com/uzhan/vue-vant-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzhan/vue-vant-template.git"
  },
  "funding": "https://github.com/sponsors/uzhan",
  "author": {
    "name": "BaiHuaYang",
    "email": "baihuayang@uphicoo.com"
  },
  "scripts": {
    "build": "vue-tsc && vite build",
    "dev": "vite",
    "lint": "eslint . && stylelint \"**/*.{css,less,scss}\"",
    "lint:fix": "prettier --write . && eslint --fix . && stylelint --fix \"**/*.{css,less,scss}\"",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "commitlint": {
    "extends": [
      "ali"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,ts,vue}": [
      "eslint --fix",
      "git add"
    ],
    "*.{vue,css,less}": [
      "stylelint --fix",
      "git add"
    ],
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}": "eslint --fix",
    "*.{css,less,scss}": "stylelint --fix",
    "*.{cjs,css,cts,html,js,json,jsx,less,md,mjs,mts,scss,ts,tsx,vue,yaml,yml}": "prettier --write"
  },
  "prettier": "prettier-config-ali",
  "eslintConfig": {
    "extends": [
      "ali/typescript/vue",
      "plugin:prettier/recommended"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-ali",
      "stylelint-prettier/recommended"
    ]
  },
  "dependencies": {
    "axios": "^1.7.7",
    "clipboard": "^2.0.11",
    "js-base64": "^3.7.7",
    "jsencrypt": "^3.3.2",
    "pinia": "^2.2.2",
    "vant": "^4.9.5",
    "vue": "^3.5.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vant/auto-import-resolver": "^1.2.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "commitlint-config-ali": "^1.1.0",
    "eslint": "^8.57.0",
    "eslint-config-ali": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.6",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "lint-staged": "^15.2.10",
    "postcss-html": "^1.7.0",
    "postcss-px-to-viewport": "^1.1.1",
    "prettier": "^3.3.3",
    "prettier-config-ali": "^1.3.2",
    "stylelint": "^16.9.0",
    "stylelint-config-ali": "^2.1.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-less": "^1.0.4",
    "stylelint-config-standard": "^30.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-less": "^1.0.8",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.2",
    "typescript": "^4.9.5",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.24.1",
    "vconsole": "^3.15.1",
    "vite": "^4.5.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.14.7",
    "vite-plugin-style-import": "^2.0.0",
    "vite-plugin-vconsole": "^1.3.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^1.8.27"
  }
}
